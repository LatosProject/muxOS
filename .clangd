# Keep clangd's editor diagnostics aligned with the include paths in Makefile.
CompileFlags:
  Add:
    - -m32
    - -ffreestanding
    - -fno-builtin
    - -fno-pic
    - -I.
    - -Iarch/x86
    - -Iarch/x86/include
    - -Ikernel
    - -Ikernel/lib
    - -Ikernel/mm
    - -Ikernel/task
    - -Ikernel/fs
    - -Ikernel/tty
    - -Idrivers/input
    - -Idrivers/platform
    - -Idrivers/serial
    - -Idrivers/video
    - -Idrivers/bus
    - -Idrivers/virtio
